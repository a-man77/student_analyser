    {
      "parameters": {
        "promptType": "define",
        "text": "=Analyze this student's data and predict academic risk:\nStudent: {{ $json.name }} (ID: {{ $json.studentId }})\nGPA: {{ $json.gpa }}\nAttendance: {{ $json.attendance }}%\nAssignments Missed: {{ $json.assignmentsMissed }}\nEngagement Score: {{ $json.engagementScore }}\n\nProvide:\n1. Risk Level (Low/Medium/High) based on:\n   - GPA < 6 = High risk\n   - Attendance < 75% = High risk\n   - GPA 6-7.5 OR Attendance 75-85% = Medium risk\n   - Otherwise = Low risk\n2. Risk Score (0-100): Weighted combination of factors\n3. Dropout Probability (0-1): Statistical likelihood based on patterns\n4. Pass Probability (0-1): Likelihood of passing the course\n5. Predicted Grade: Forecasted final grade based on current trajectory\n6. Trends: Identify patterns (improving, declining, stable)\n7. Anomalies: Detect unusual patterns (sudden drops, inconsistencies)\n8. Recommendations: Specific, actionable interventions tailored to this student's situation \nRespond with ONLY a valid JSON object in this exact format, and nothing else (no markdown, no code fences, no explanation):\n{\"riskLevel\":\"Low\",\"riskScore\":15,\"dropoutProbability\":0.08,\"passProbability\":0.95,\"predictedGrade\":87,\"trends\":[\"...\"],\"anomalies\":[],\"recommendations\":[\"...\"]}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are an expert educational data analyst specializing in student risk assessment and early intervention. Analyze student performance data to predict academic outcomes and provide evidence-based recommendations."
        }
      },
