      "parameters": {
        "jsCode": "// Clean and validate student data\nconst cleanedItems = [];\n\nfor (const item of $input.all()) {\n  const data = item.json;\n\n  // Skip rows with missing critical fields\n  if (!data.student_id || !data.name) continue;\n\n  // Normalize and clean data\n  const cleaned = {\n    studentId: String(data.student_id).trim(),\n    name: String(data.name).trim(),\n    gpa: parseFloat(data.gpa) || 0,\n    attendance: parseFloat(data.attendance) || 0,\n    assignmentsMissed: parseInt(data.assignments_missed) || 0,\n    engagementScore: parseFloat(data.engagement_score) || 0,\n    // Add timestamp\n    uploadedAt: new Date().toISOString()\n  };\n\n  cleanedItems.push({ json: cleaned });\n}\n\nreturn cleanedItems;"
      },
