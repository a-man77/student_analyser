    {
      "parameters": {
        "jsCode": "const students = $input.all().map(item => item.json);\nconst totalStudents = students.length;\n\n// Normalize risk level for consistent matching (handles casing/whitespace issues)\nconst norm = s => (s.risk_level || '').trim().toLowerCase();\n\nconst highRisk = students.filter(s => norm(s) === 'high').length;\nconst mediumRisk = students.filter(s => norm(s) === 'medium').length;\nconst lowRisk = students.filter(s => norm(s) === 'low').length;\n\n// Averages\nconst avgGrade = totalStudents\n  ? students.reduce((sum, s) => sum + (parseFloat(s.gpa) || 0), 0) / totalStudents\n  : 0;\n\nconst avgAttendance = totalStudents\n  ? students.reduce((sum, s) => sum + (parseFloat(s.attendance) || 0), 0) / totalStudents\n  : 0;\n\nconst avgDropoutProb = totalStudents\n  ? students.reduce((sum, s) => sum + (parseFloat(s.risk_score) || 0), 0) / totalStudents\n  : 0;\n\n// Risk distribution\nconst riskDistribution = {\n  High: highRisk,\n  Medium: mediumRisk,\n  Low: lowRisk\n};\n\n// Performance trends (GPA on a 0-10 scale)\nconst performanceTrends = {\n  'A (90-100)': students.filter(s => s.gpa >= 9).length,\n  'B (80-89)': students.filter(s => s.gpa >= 8 && s.gpa < 9).length,\n  'C (70-79)': students.filter(s => s.gpa >= 7 && s.gpa < 8).length,\n  'D (60-69)': students.filter(s => s.gpa >= 6 && s.gpa < 7).length,\n  'F (<60)': students.filter(s => s.gpa < 6).length\n};\n\n// Top at-risk students (High or Medium, sorted by risk score)\nconst atRiskStudents = students\n  .filter(s => norm(s) === 'high' || norm(s) === 'medium')\n  .sort((a, b) => (b.risk_score || 0) - (a.risk_score || 0))\n  .slice(0, 10);\n\nreturn [{\n  json: {\n    overview: {\n      totalStudents,\n      highRisk,\n      mediumRisk,\n      lowRisk,\n      avgGrade: avgGrade.toFixed(2),\n      avgAttendance: avgAttendance.toFixed(2),\n      avgDropoutProb: avgDropoutProb.toFixed(2)\n    },\n    riskDistribution,\n    performanceTrends,\n    atRiskStudents,\n    allStudents: students,\n    generatedAt: new Date().toISOString()\n  }\n}];\n\n\n"
      },
      "id": "ce6d4516-c8a7-48d6-94aa-6142703ace8d",
      "name": "Calculate Dashboard KPIs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        832,
        48
      ]
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\nconst html = `<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"UTF-8\">\n  <style>\n    body { font-family: Arial, sans-serif; margin: 40px; }\n    h1 { color: #2c3e50; border-bottom: 3px solid #3498db; padding-bottom: 10px; }\n    h2 { color: #34495e; margin-top: 30px; }\n    .kpi-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin: 20px 0; }\n    .kpi-card { background: #ecf0f1; padding: 20px; border-radius: 8px; text-align: center; }\n    .kpi-value { font-size: 32px; font-weight: bold; color: #2980b9; }\n    .kpi-label { font-size: 14px; color: #7f8c8d; margin-top: 5px; }\n    table { width: 100%; border-collapse: collapse; margin: 20px 0; }\n    th { background: #3498db; color: white; padding: 12px; text-align: left; }\n    td { padding: 10px; border-bottom: 1px solid #ddd; }\n    tr:hover { background: #f5f5f5; }\n    .risk-high { color: #e74c3c; font-weight: bold; }\n    .risk-medium { color: #f39c12; font-weight: bold; }\n    .risk-low { color: #27ae60; font-weight: bold; }\n  </style>\n</head>\n<body>\n  <h1>Student Analytics Report</h1>\n  <p><strong>Generated:</strong> ${new Date().toLocaleString()}</p>\n\n  <h2>Overview KPIs</h2>\n  <div class=\"kpi-grid\">\n    <div class=\"kpi-card\">\n      <div class=\"kpi-value\">${data.overview.totalStudents}</div>\n      <div class=\"kpi-label\">Total Students</div>\n    </div>\n    <div class=\"kpi-card\">\n      <div class=\"kpi-value\">${data.overview.avgGrade}</div>\n      <div class=\"kpi-label\">Average Grade (GPA)</div>\n    </div>\n    <div class=\"kpi-card\">\n      <div class=\"kpi-value\">${data.overview.avgAttendance}%</div>\n      <div class=\"kpi-label\">Average Attendance</div>\n    </div>\n  </div>\n\n  <h2>Risk Distribution</h2>\n  <div class=\"kpi-grid\">\n    <div class=\"kpi-card\">\n      <div class=\"kpi-value\">${data.riskDistribution.High}</div>\n      <div class=\"kpi-label\">High Risk</div>\n    </div>\n    <div class=\"kpi-card\">\n      <div class=\"kpi-value\">${data.riskDistribution.Medium}</div>\n      <div class=\"kpi-label\">Medium Risk</div>\n    </div>\n    <div class=\"kpi-card\">\n      <div class=\"kpi-value\">${data.riskDistribution.Low}</div>\n      <div class=\"kpi-label\">Low Risk</div>\n    </div>\n  </div>\n\n  <h2>Top At-Risk Students</h2>\n  <table>\n    <thead>\n      <tr>\n        <th>Student ID</th>\n        <th>Name</th>\n        <th>Risk Level</th>\n        <th>Risk Score</th>\n        <th>Grade</th>\n        <th>Attendance</th>\n        <th>Dropout Prob</th>\n      </tr>\n    </thead>\n    <tbody>\n      ${data.atRiskStudents.map(s => `\n        <tr>\n          <td>${s.student_id}</td>\n          <td>${s.name}</td>\n          <td class=\"risk-${(s.risk_level || '').toLowerCase()}\">${s.risk_level}</td>\n          <td>${s.risk_score}</td>\n          <td>${s.gpa}</td>\n          <td>${s.attendance}%</td>\n          <td>${s.dropout_probability ? (s.dropout_probability * 100).toFixed(1) + '%' : 'N/A'}</td>\n        </tr>\n      `).join('')}\n    </tbody>\n  </table>\n\n  <h2>Performance Distribution</h2>\n  <table>\n    <thead>\n      <tr>\n        <th>Grade Range</th>\n        <th>Number of Students</th>\n        <th>Percentage</th>\n      </tr>\n    </thead>\n    <tbody>\n      ${Object.entries(data.performanceTrends).map(([range, count]) => `\n        <tr>\n          <td>${range}</td>\n          <td>${count}</td>\n          <td>${((count / data.overview.totalStudents) * 100).toFixed(1)}%</td>\n        </tr>\n      `).join('')}\n    </tbody>\n  </table>\n</body>\n</html>`;\n\nreturn [{ json: { html } }];\n  \n  "
      },
